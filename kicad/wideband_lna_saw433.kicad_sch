		(uuid "0453293e-d8c3-4999-8648-9e95b097edee")
	)
	(text "B3790 matching (datasheet): 56 nH series IN / OUT,\n56 nH SHAPE to GND. Layout: own GND via per transducer\nGND pad, no top pour joining them."
		(exclude_from_sim no)
		(at 101.6 97.79 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "69d8feef-2395-4ea2-bff9-8baef1fd08b5")
	)
	(text "AS179-92LF: V1 high = J1-J3, V2 high = J1-J2. U1: J3 = SAW (V1 = CTL_FILT);\nU2: J2 = SAW (V2 = CTL_FILT), so the paths do not cross on the board.\nControl 2-5 V. RF ports DC-isolated (1 nF; SAW is DC-open).\nC2, C3, C5, C6 sit at the V1 / V2 pins."
		(exclude_from_sim no)
		(at 101.6 113.03 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4700f21a-18af-4a26-886a-d9a24a153c5a")
	)
